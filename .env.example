# --- Provider selection: groq | cerebras | deepinfra | gemini ---
LLM_PROVIDER = groq

# --- Groq ---
GROQ_API_KEY = your_groq_key
GROQ_MODEL = openai/gpt-oss-120b
GROQ_MODEL_INFERENCE = openai/gpt-oss-20b

# --- Se detecta la intención del usuario por medio LLM (YES/NO) ---
CLASSIFY_INFERENCE = NO

# --- Cerebras ---
CEREBRAS_KEY = your_cerebras_key
CEREBRAS_MODEL = gemma-4-31b

# --- DeepInfra (OpenAI-compatible) ---
DEEPINFRA_API_KEY = your_deepinfra_key
DEEPINFRA_MODEL = google/gemma-4-31B-it-turbo

# --- Gemini ---
GEMINI_API_KEY = your_gemini_key
GEMINI_MODEL = gemini-2.0-flash

# --- PostgreSQL ---
DB_HOST = localhost
DB_PORT = 5432
DB_NAME = your_database_name
DB_USER = your_db_user
DB_PASSWORD = your_db_password

# --- Telegram ---
TELEGRA_BOT_TOKEN = your_botfather_telegram_token

# --- Archivo fuente de ventas (opcional) ---
# DATA_FILE_PATH: ruta COMPLETA al archivo .txt de red (incluye el nombre
#   del archivo). Si esta definida, la ingesta primero COPIA ese archivo a
#   la carpeta local (ver DATA_FILE_PATH_LOCAL) y luego siempre lee/parsea
#   desde la copia local — nunca directo de la red.
#   Requiere correr el script desde una terminal SIN "Ejecutar como
#   administrador": una terminal elevada no ve unidades de red mapeadas
#   (M:\...) que si son visibles en la sesion normal del usuario. Si se usa
#   una terminal elevada, usar ruta UNC (\\servidor\carpeta\archivo.txt) en
#   vez de la unidad mapeada.
# DATA_FILE_PATH_LOCAL: DIRECTORIO local base, con subcarpetas /2025 y /2026
#   (el nombre del archivo se arma solo: BSPlanaVentas{año}.txt). Si
#   DATA_FILE_PATH no esta definida, la ingesta lee directo de aca.
#   Si no se define, usa 'data_samples' (comportamiento por defecto).
DATA_FILE_PATH = \\servidor\carpeta\BSPlanaVentas2026.txt
DATA_FILE_PATH_LOCAL = data_samples

# --- Maestra de items (opcional) ---
# ITEMS_EXCEL_PATH: ruta COMPLETA al .xlsx maestro de items (con las Power
#   Query que consultan SVR-DBSIESA). Usada por scripts/exportar_items_excel.py
#   para refrescar y exportar data_samples/items/MAESTRA DE ITEMS.csv.
#   Requiere Excel instalado en la maquina que corre el script.
ITEMS_EXCEL_PATH = C:\Users\usuario\Desktop\MAESTRA DE ITEMS.xlsx

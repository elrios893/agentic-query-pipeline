# --- Provider selection: groq | cerebras | gemini ---
LLM_PROVIDER = groq

# --- Groq ---
GROQ_API_KEY = your_groq_key
GROQ_MODEL = llama-3.3-70b-versatile
GROQ_MODEL_INFERENCE = llama-3.1-8b-instant

# --- Se detecta la intención del usuario por medio LLM (YES/NO) ---
CLASSIFY_INFERENCE = NO

# --- Cerebras ---
CEREBRAS_KEY = your_cerebras_key
CEREBRAS_MODEL = gemma-4-31b

# --- Gemini ---
GEMINI_API_KEY = your_gemini_key
GEMINI_MODEL = gemini-2.0-flash

# --- PostgreSQL ---
DB_HOST = localhost
DB_PORT = 5432
DB_NAME = your_database_name
DB_USER = your_db_user
DB_PASSWORD = your_db_password

# --- Telegram ---
TELEGRA_BOT_TOKEN = your_botfather_telegram_token
